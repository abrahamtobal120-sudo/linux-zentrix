#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="$CONFIG_HOME/zinarix"
STATE_FILE="$STATE_DIR/kde-defaults-applied"
DEFAULT_WALLPAPER="/usr/share/wallpapers/zinarix-dark.svg"

mkdir -p "$STATE_DIR"

# Keep the Plasma startup fully branded as Zinarix OS. Do not apply a KDE
# global look-and-feel here because that can restore the KDE/Breeze splash.
if command -v kwriteconfig6 >/dev/null 2>&1; then
  kwriteconfig6 --file ksplashrc --group KSplash --key Engine KSplashQML
  kwriteconfig6 --file ksplashrc --group KSplash --key Theme org.zinarix.desktop
else
  cat > "$CONFIG_HOME/ksplashrc" <<'EOT'
[KSplash]
Engine=KSplashQML
Theme=org.zinarix.desktop
EOT
fi

if [[ -f "$STATE_FILE" ]]; then
  exit 0
fi

if command -v plasma-apply-colorscheme >/dev/null 2>&1; then
  plasma-apply-colorscheme BreezeDark >/dev/null 2>&1 || true
fi

if command -v plasma-apply-wallpaperimage >/dev/null 2>&1 && [[ -f "$DEFAULT_WALLPAPER" ]]; then
  plasma-apply-wallpaperimage "$DEFAULT_WALLPAPER" >/dev/null 2>&1 || true
fi

date +%s > "$STATE_FILE"
