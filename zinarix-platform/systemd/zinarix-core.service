[Unit]
Description=Zinarix Core Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/share/zinarix-platform
ExecStart=/usr/bin/python /usr/share/zinarix-platform/daemon/main.py --config /etc/zinarix/zinarix.yaml --bus system
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
