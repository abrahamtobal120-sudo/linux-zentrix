<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Zinarix</vendor>
  <vendor_url>https://zinarix.local</vendor_url>

  <action id="org.zinarix.core.profile.apply">
    <description>Apply Zinarix system profile</description>
    <message>Authentication is required to apply Zinarix profile changes.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.zinarix.core.drivers.install">
    <description>Install recommended drivers from trusted sources</description>
    <message>Authentication is required to install drivers.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <action id="org.zinarix.core.recovery.run">
    <description>Run Zinarix recovery operation</description>
    <message>Authentication is required to run recovery operations.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
